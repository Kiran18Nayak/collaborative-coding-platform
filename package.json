{
  "name": "collaborative-coding-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time collaborative coding platform",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "tunnel": "node server/tunnel.js",
    "local": "node server/server.js",
    "jdoodle": "node jdoodle-backend/server.js",
    "start:all": "concurrently \"npm run jdoodle\" \"npm run start\"",
    "start:all-tunnel": "concurrently \"npm run jdoodle\" \"npm run tunnel\""
  },
  "dependencies": {
    "axios": "^1.8.3",
    "body-parser": "^1.20.3",
    "child_process": "^1.0.2",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "ngrok": "^5.0.0-beta.2",
    "socket.io": "^4.7.2",
    "tmp": "^0.2.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
